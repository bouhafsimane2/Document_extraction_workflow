# Copier ce fichier en .env puis remplir. Ne JAMAIS publier le fichier .env sur GitHub.

# --- Docker (docker-compose.yml) ---
# Clé qui chiffre les credentials dans n8n. Générer une longue chaîne aléatoire et la conserver :
# si elle est perdue, il faut ressaisir tous les credentials.
N8N_ENCRYPTION_KEY=
N8N_HOST_PORT=5678
N8N_PUBLIC_URL=http://localhost:5678/
TIMEZONE=Africa/Algiers
OCR_ENGINE=docling

# --- Scripts Python (évaluation, envoi des emails de test) ---
# Chaîne de connexion Supabase (Connect -> Session pooler)
EXTRACTION_DSN=postgresql://postgres.<ref>:<mot_de_passe>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Mot de passe d'application Gmail, utilisé par send_test_emails.py
SMTP_PASSWORD=
