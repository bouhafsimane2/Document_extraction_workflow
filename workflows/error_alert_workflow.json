  "name": "Document Extraction - Error Alert",
  "nodes": [
    {
      "parameters": {},
      "id": "5befc201-a57f-4f0b-b326-5a8e5de50b80",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
