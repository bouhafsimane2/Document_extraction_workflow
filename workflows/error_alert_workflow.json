        0,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const e = $json.execution || {};\nconst w = $json.workflow || {};\nconst message = (e.error && (e.error.message || e.error.description)) || 'Erreur inconnue';\nreturn { json: {\n  workflow_name: w.name || null,\n  execution_id: e.id ? String(e.id) : null,\n  execution_url: e.url || null,\n  last_node: e.lastNodeExecuted || null,\n  error_message: message,\n  html: `<h2>&#9888; Échec du workflow « ${w.name} »</h2><p><b>Nœud :</b> ${e.lastNodeExecuted}<br><b>Erreur :</b> ${message}</p>` +\n        (e.url ? `<p><a href=\"${e.url}\">Voir l'exécution</a></p>` : '') +\n        '<p>Le document concerné n\\'a PAS été enregistré : relancer l\\'exécution après correction.</p>',\n} };\n",
        "mode": "runOnceForEachItem"
      },
      "id": "c1adad33-1dd5-4247-8cbf-303347f9a069",
      "name": "Format Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "return { json: {\n  workflow_name: $json.workflow_name, execution_id: $json.execution_id,\n  execution_url: $json.execution_url, last_node: $json.last_node, error_message: $json.error_message,\n} };\n",
        "mode": "runOnceForEachItem"
      },
      "id": "c5daadf1-dd03-4df1-9b7e-18e6e83efc71",
